# Copy this file to .env.local and fill in real values. Never commit .env.local.

# Supabase project URL (Project Settings -> API in the Supabase dashboard).
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anonymous/public API key (Project Settings -> API). Safe to expose
# to the browser; access is enforced by Postgres RLS policies, not this key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Mapbox access token used to render the venue map (components/VenueMap.tsx).
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=

# NOTE: NEXT_PUBLIC_GOOGLE_MAPS_API_KEY is intentionally not listed here.
# Google Maps was replaced by Mapbox; that key is dead config.
# NOTE: JWT_SECRET is intentionally not listed here either. It belonged to
# the invite flow removed in D11 (see docs/tech-debt-backlog.md) and is no
# longer read anywhere in the app.
