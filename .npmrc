# eslint-plugin-react / eslint-plugin-import / eslint-plugin-jsx-a11y all cap
# their `eslint` peerDependency at ^9.7, but the repo is on eslint@10 (needed
# for eslint-config-next@16 / flat config support). npm's default strict
# resolution treats that as a hard error for direct devDependencies (it only
# warns for transitive ones, which is why `npm install` already printed
# "ERESOLVE overriding peer dependency" warnings before this file existed).
# Same peer range, so same actual runtime compatibility — legacy-peer-deps
# just stops npm treating the mismatch as fatal. Safe to drop once the ESLint
# plugin ecosystem catches up to eslint 10.
legacy-peer-deps=true
